rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mediciones del sensor
    match /mediciones/{doc} {
      allow read: if true;
      allow create: if request.resource.data.humedad is number
                    && request.resource.data.humedad >= 0
                    && request.resource.data.humedad <= 100
                    && request.resource.data.fecha is timestamp
                    && request.resource.data.sensorId is string;
      allow update, delete: if false;
    }

    // Perfiles:
    match /perfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás queda bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
